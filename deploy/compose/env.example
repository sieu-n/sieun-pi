# Copy to .env at the repo root to change a default; compose reads it at every `up`. Every line is optional.

# The model credential. Without it the instance still starts, and each agent turn fails with "no token (no_api_key)".
ANTHROPIC_API_KEY=

# Where the chat answers on this box: http://${SWF_BIND}:${SWF_PORT}. The fixture profile uses SWF_FIXTURE_PORT.
SWF_BIND=127.0.0.1
SWF_PORT=5190
SWF_FIXTURE_PORT=5191

# The box name the chat shows for this instance's pi-host.
SWF_BOX=dev

# Meilisearch's master key. Meilisearch is reachable only on the project's network, so the default is fine for a dev box.
MEILI_MASTER_KEY=

# Only for deploy/compose/compose.pool.yaml (a box with pi-pool): the uid and gid that own ~/.config/pi-pool, from `id -u` and `id -g`.
SWF_UID=
SWF_GID=
