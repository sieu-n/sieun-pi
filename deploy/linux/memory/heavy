#!/bin/sh
# heavy SIZE -- CMD [ARGS]: run a job known to be heavy in its own memory box, memory layer 4 of
# https://cho.sh/ko/1983DC (owner ask, 2026-10-19). Past SIZE the kernel kills that job alone, with no swap, and its
# oom_score_adj of 500 makes earlyoom and the kernel pick it before anything else when the whole box runs short.
# Example: heavy 8G -- pnpm svelte-check. Where systemd is absent, as on the Mac, it runs CMD as is.
set -eu
if [ $# -lt 2 ]; then echo "usage: heavy <size such as 8G> -- <cmd> [args]" >&2; exit 2; fi
size=$1; shift
if [ "$1" = "--" ]; then shift; fi
if [ $# -eq 0 ]; then echo "usage: heavy <size such as 8G> -- <cmd> [args]" >&2; exit 2; fi
if ! command -v systemd-run >/dev/null 2>&1 || [ ! -d /run/systemd/system ]; then exec "$@"; fi
# A vitest run in the box sizes its pool to SIZE at one worker per GiB, instead of vitest's default of one per core
# but one, which is 79 on us-metal02. measured: on 10-30 the 191-file apps/virev-demo unit suite peaked at 4.7 to
# 5.6 GiB on 8 workers over 4 runs under heavy 8G (0.7 GiB a worker), while 1 of 2 runs on 13 workers and the runs on
# 79 hit 8 GiB and were OOM-killed. It took 111 s on 8 workers and 102 s on 16, and 47 root Convex integration files
# took 55 s on 8, 16 and 45 workers alike. Prime's packages/coding-agent suite under heavy 24G took 134 and 140 s at
# 11.7 GiB on 24 workers against 151 and 153 s at 17.2 GiB on 79. A VITEST_MAX_WORKERS or --maxWorkers the caller sets wins.
gib() {
	n=${1%[KkMmGgTt]}
	case $n in '' | *[!0-9]*) return 1 ;; esac
	case $1 in
	*[Tt]) echo $((n * 1024)) ;; *[Gg]) echo "$n" ;; *[Mm]) echo $((n / 1024)) ;; *[Kk]) echo $((n / 1048576)) ;;
	*) echo $((n / 1073741824)) ;;
	esac
}
if [ -z "${VITEST_MAX_WORKERS:-}" ] && workers=$(gib "$size"); then
	set_workers=1
	for arg in "$@"; do case $arg in --maxWorkers* | --max-workers*) set_workers= ;; esac; done
	if [ -n "$set_workers" ]; then
		[ "$workers" -ge 1 ] || workers=1
		VITEST_MAX_WORKERS=$workers
		export VITEST_MAX_WORKERS
	fi
fi
# CMD runs as the main process of a transient service, so once it exits systemd stops the unit and kills every process left in its cgroup,
# also when heavy itself was SIGKILLed. A scope outlives its command while any process stays in it: at 11:05Z on 11-08 33 run-p scopes on
# us-metal02 still held 36 Prime test daemons and workers, 3.1 GB, that 33 `heavy 8G -- npx vitest` runs of daemon-supervisor-process.test.ts
# had left on 11-04 from 09:11Z to 10:03Z, and the shell that fdd314f2 ran in the scope to kill them dies with a SIGKILL of the caller's
# process group, which left the leftover alive in a run on 11-08. A service starts from the user manager's environment, so heavy passes its
# own on with -E, less the variables systemd sets for a unit, and --expand-environment=no keeps systemd from rewriting $VAR in CMD.
unit=heavy-$$-$(date +%s%N).service
names=$(env -0 | tr '\n\0' '\001\n' | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | grep -vxE '_|INVOCATION_ID|NOTIFY_SOCKET|JOURNAL_STREAM|SYSTEMD_EXEC_PID|MANAGERPID|MANAGERPIDFDID|MAINPID|MAINPIDFDID|PIDFILE|MEMORY_PRESSURE_WATCH|MEMORY_PRESSURE_WRITE|LISTEN_[A-Z]+|WATCHDOG_[A-Z]+' || :)
setenv=
for name in $names; do setenv="$setenv -E $name"; done
# systemd-run ignores TERM, INT and HUP, so it stays to report CMD's exit code, and heavy sends each of them to CMD. A signal can come before
# systemd has started the unit, so the send is retried until it lands or systemd-run is gone.
trap '' TERM INT HUP
exec 3<&0
# shellcheck disable=SC2086
systemd-run --user --wait --pipe --collect --quiet --same-dir --expand-environment=no --unit="$unit" -p MemoryMax="$size" -p MemorySwapMax=0 \
	$setenv -- choom -n 500 -- "$@" <&3 3<&- &
pid=$!
exec 3<&-
to_cmd() {
	(until systemctl --user kill --kill-whom=main --signal="$1" "$unit" 2>/dev/null; do
		kill -0 "$pid" 2>/dev/null || exit 0
		sleep 0.2
	done) </dev/null >/dev/null 2>&1 &
}
trap 'to_cmd TERM' TERM
trap 'to_cmd INT' INT
trap 'to_cmd HUP' HUP
# A trap cuts a wait short, so heavy waits until systemd-run is gone and then reads its saved status.
while kill -0 "$pid" 2>/dev/null; do wait "$pid" || :; done
rc=0
wait "$pid" || rc=$?
exit "$rc"
