[Unit]
Description=THP defrag never: a huge page fault takes a free huge page or falls back to small pages, and neither compacts nor wakes kswapd (memory layer 7, deploy/linux/README.md)
DefaultDependencies=no
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo never > /sys/kernel/mm/transparent_hugepage/defrag'

[Install]
WantedBy=sysinit.target
