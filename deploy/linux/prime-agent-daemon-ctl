#!/usr/bin/python3 -B
"""Start and update the Prime Agent daemon for prime-agent-daemon.service.

start   Adopt the supervisor that answers on the socket, or start one, and write its PID to the PIDFile.
update  Install with `prime-agent update $PRIME_UPDATE_ARGS` inside the unit, run Prime's update restart
        coordinator for the socket with the unit's clean environment, then do what start does for the successor.

The unit is Type=forking with PIDFile=, and systemd reads the PIDFile after ExecStart and after a
successful ExecReload, so MainPID names the supervisor that owns the socket. Prime's update restart
coordinator starts the successor supervisor itself, and session workers start a replacement when the
supervisor goes away, so the supervisor is often not the process the unit started.

Every prime-agent process this script starts targets the socket argument and nothing else. `prime-agent update`
picks its daemon from PRIME_AGENT_INTERNAL_DAEMON_SUPERVISOR_SOCKET, then $TMPDIR/prime-agent-<uid>/daemon.sock
(the public command refuses --daemon-socket), and Prime keeps its coordinator registry under
$TMPDIR/prime-agent-<uid>. So the script sets TMPDIR to the directory above the socket's prime-agent-<uid>
directory, drops the inherited PRIME_AGENT_INTERNAL_* worker variables, and sets
PRIME_AGENT_INTERNAL_DAEMON_SUPERVISOR_SOCKET to the socket for the install only. The coordinator and the daemon it
starts get --daemon-socket instead.

The update runs in two steps, because Prime's coordinator copies the environment of `prime-agent update` into the
successor supervisor, and every worker and agent shell inherits it. On 10-18 the 06:46Z successor and its 20 workers
kept the test feed's PRIME_AGENT_DOWNLOAD_BASE_URL and PRIME_AGENT_ALLOW_INSECURE_HTTP_FOR_TESTS after the update.
1. `prime-agent update --self` with PRIME_AGENT_INTERACTIVE_SELF_UPDATE=1 and the feed variables installs the release
   and exits without a restart. That variable makes Prime skip its public argument rewrite, so the ctl passes the
   --self target that the rewrite adds. It still asks the busy-session confirmation that --force answers.
2. `prime-agent update --internal-update-restart-coordinator --daemon-socket <socket>
   --internal-update-restart-status <agent dir>/update-restarts/<file>` without the feed variables runs the same
   coordinator that `prime-agent update` launches after an install, so the successor gets the unit's environment.
   The ctl reads the coordinator's status file and prints Prime's own report lines for it.

When Prime reports restart-failed, update still exits 0 once a supervisor owns the socket, with its PID in the
PIDFile. By then the coordinator has often stopped the predecessor and started a successor that came up after the
coordinator stopped waiting (10-18 06:47Z: 33.5 s startup, timeout 2 s before it listened). systemd re-reads the
PIDFile only after a successful ExecReload. After a failed one it finds the old MainPID dead, counts the unit as
stopped and Restart= starts it again. The journal line then reads result=restore-failed-successor-adopted with
`restored N of M` from the coordinator's update-restarts record, so neither it nor prime-install.sh's <log>.result
says ok, and Prime's own recovery handles the sessions the coordinator did not restore.

When the daemon start launches exits before it answers, often with ELOCKED because a successor that Prime's
coordinator started still holds the socket lock, start waits for that supervisor's hello and adopts it. It has no
hard timeout: TimeoutStartSec=infinity also covers ExecReload, and the wait logs one line past
SUCCESSOR_START_SECONDS. If the lock holder exits without a hello, start launches a daemon again.

Before start launches a daemon, and once more if that daemon exits before it answers, it removes a socket lock
directory that a newer Prime build left behind with owner.json in it, when its owner is proved gone (see
clear_dead_lock). mem.3 and older only rmdir a stale lock, so after such an owner crashes a rolled-back binary would
fail with ENOTEMPTY on every start.

update empties the env file argument, the unit's prime-update.env, before it starts the updater, because systemd
has already loaded it into this process and a later start or reload must not pick up the same args and feed settings.

PRIME_UPDATE_ARGS takes --force and --rollback. --force answers Prime's busy-session confirmation, which refuses
without a TTY; it does not override a prepare refusal, where the running daemon declines the restart because a
worker is failed, disconnected or not ready.

usage: prime-agent-daemon-ctl start|update <prime-agent> <socket> <pidfile> [<update env file>]
"""
import ctypes
import fcntl
import json
import os
import shlex
import socket
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

POLL_SECONDS = 0.1
UPDATE_ARGS = ("--force", "--rollback")
KEEP_INTERNAL = ("PRIME_AGENT_INTERNAL_DAEMON_SUPERVISOR_REGISTRY_DIR",)
FEED = ("PRIME_AGENT_DOWNLOAD_BASE_URL", "PRIME_AGENT_ALLOW_INSECURE_HTTP_FOR_TESTS")
INSTALL_ONLY = "PRIME_AGENT_INTERACTIVE_SELF_UPDATE"
DROP = (INSTALL_ONLY, "PRIME_UPDATE_ARGS", *FEED)
COORDINATOR_FLAG = "--internal-update-restart-coordinator"
STATUS_FLAG = "--internal-update-restart-status"
# Prime's exit code for an install-only update that installed nothing: no newer release, a refused downgrade or an
# unreachable feed.
NOT_ATTEMPTED = 75

# Exit codes for update, one per outcome, so prime-install.sh and the journal tell them apart.
OK = 0
FAILED = 1
USAGE = 2
BUSY_REFUSED = 3
PREPARE_REFUSED = 4
RESTART_FAILED = 5

# Native deadlines in prime-agent 0.9.8-daemon-fix.1-mem.2 that bound one update restart coordinator.
# Fixed steps: list 30 s, prepare_update_restart 120 s, predecessor stop 10 s, startup fence 60 s,
# daemon launch 2 x 30 s, successor hello 60 s, restore connect 10 s, registry lock 5 s.
# Each restored session: create 120 s, update note 30 s, next turn 30 s, actions 30 s, resume prompt 120 s,
# resume queue 30 s. Prime has no total deadline, so the unit sets TimeoutStartSec=infinity and this
# budget is a soft target that the wait loop reports once when a coordinator runs past it.
COORDINATOR_FIXED_SECONDS = 355
COORDINATOR_PER_SESSION_SECONDS = 360
# The part of those deadlines that covers one successor from launch to hello: startup fence 60 s, daemon launch
# 2 x 30 s, successor hello 60 s. start() logs once when a supervisor that holds the socket lock runs past it.
SUCCESSOR_START_SECONDS = 180
OWNER_FILE = "owner.json"
LIBC = ctypes.CDLL(None, use_errno=True)
AT_FDCWD = -100
RENAME_NOREPLACE = 1


def alive(pid):
    try:
        state = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0]
    except (OSError, IndexError):
        return False
    return state not in ("Z", "X")


def target_env(sock, **extra):
    """The environment for every prime-agent this script starts, pinned to the socket argument."""
    env = {k: v for k, v in os.environ.items() if not (k.startswith("PRIME_AGENT_INTERNAL_") and k not in KEEP_INTERNAL) and k not in DROP}
    env["TMPDIR"] = str(Path(sock).parent.parent)
    return {**env, **extra}


def supervisor_pid(sock):
    """PID from the daemon_hello line the supervisor sends on connect, or None.

    The 1 s connect and 2 s hello waits are the ones Prime's own client uses before an update restart.
    """
    try:
        with socket.socket(socket.AF_UNIX) as conn:
            conn.settimeout(1)
            conn.connect(sock)
            conn.settimeout(2)
            data = b""
            while b"\n" not in data:
                chunk = conn.recv(65536)
                if not chunk:
                    return None
                data += chunk
        hello = json.loads(data.split(b"\n", 1)[0])
    except (OSError, ValueError):
        return None
    pid = hello.get("supervisorPid") if isinstance(hello, dict) else None
    if hello.get("type") != "daemon_hello" or not isinstance(pid, int) or pid <= 0:
        return None
    if os.path.realpath(str(hello.get("supervisorSocketPath"))) != os.path.realpath(sock):
        return None
    return pid if alive(pid) else None


def update_restart_coordinator(sock):
    """The registry record of a live Prime update restart coordinator for this socket, or None; it starts the successor itself."""
    registry = Path(sock).parent / "update-restart-coordinators"
    for path in registry.glob("*.json"):
        try:
            record = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(record, dict) or record.get("socketPath") != sock:
            continue
        pid = record.get("pid")
        if isinstance(pid, int) and pid > 0 and alive(pid):
            return record
    return None


def coordinator_age(record):
    try:
        return time.time() - datetime.fromisoformat(record["createdAt"]).timestamp()
    except (KeyError, TypeError, ValueError):
        return 0


def coordinator_budget(record):
    try:
        total = json.loads(Path(record["statusPath"]).read_text())["counts"]["total"]
    except (OSError, ValueError, KeyError, TypeError):
        total = 0
    return COORDINATOR_FIXED_SECONDS + COORDINATOR_PER_SESSION_SECONDS * (total if isinstance(total, int) else 0)


def cgroup(pid):
    try:
        return Path(f"/proc/{pid}/cgroup").read_text().strip()
    except OSError:
        return ""


def write_pidfile(pidfile, pid):
    tmp = f"{pidfile}.tmp"
    Path(tmp).write_text(f"{pid}\n")
    os.replace(tmp, pidfile)


def socket_daemons(sock, exclude):
    """PIDs of live `prime-agent --mode daemon --daemon-socket <sock>` processes other than exclude: the lock holders."""
    pids = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit() or int(entry.name) in exclude:
            continue
        try:
            argv = [a.decode(errors="replace") for a in (entry / "cmdline").read_bytes().split(b"\0")]
        except OSError:
            continue
        for at, arg in enumerate(argv[:-1]):
            if arg == "--daemon-socket" and argv[at + 1] == sock and "--mode" in argv and argv[argv.index("--mode") + 1:argv.index("--mode") + 2] == ["daemon"]:
                if alive(int(entry.name)):
                    pids.append(int(entry.name))
                break
    return pids


def start_id(pid):
    """The start id Prime records for pid, `proc:<starttime>` from /proc/<pid>/stat, or None."""
    try:
        start = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None
    return f"proc:{start}"


def lock_owner(dirfd):
    """owner.json in an open socket lock directory as a dict with an int pid and a str token, or a reason it is not one."""
    try:
        fd = os.open(OWNER_FILE, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dirfd)
    except FileNotFoundError:
        return "it has no owner.json, so no generation names its owner"
    except OSError as error:
        return f"its owner.json is unreadable ({error.strerror})"
    with os.fdopen(fd) as f:
        try:
            owner = json.loads(f.read())
        except ValueError:
            return "its owner.json is not JSON"
    if not isinstance(owner, dict) or owner.get("version") != 1 or not isinstance(owner.get("token"), str) or not owner["token"] or type(owner.get("pid")) is not int or owner["pid"] <= 0:
        return "its owner.json has no version 1 token and pid"
    if "processStartId" in owner and not isinstance(owner["processStartId"], str):
        return "its owner.json has a processStartId that is not a string"
    return owner


def owner_gone(owner):
    """Why the process that owner.json names can no longer hold the lock, or None when that is not proved."""
    pid, recorded = owner["pid"], owner.get("processStartId")
    if not alive(pid):
        return f"pid {pid} has exited", None
    if not recorded:
        return None, f"pid {pid} is alive and owner.json records no start id, so pid reuse cannot be told apart from the owner"
    if not recorded.startswith("proc:"):
        return None, f"pid {pid} is alive and owner.json records start id {recorded}, which /proc cannot check"
    observed = start_id(pid)
    if observed is None or observed == recorded:
        return None, f"pid {pid} is alive with the recorded start id {recorded} (running or halted)"
    return f"pid {pid} now runs another process (start id {observed}, owner.json records {recorded})", None


def rename_noreplace(old, new):
    if LIBC.renameat2(AT_FDCWD, os.fsencode(old), AT_FDCWD, os.fsencode(new), RENAME_NOREPLACE) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error), new)


def clear_dead_lock(sock):
    """Remove <sock>.lock when its owner.json names an owner that is proved gone, and return whether it did.

    A Prime build newer than 0.9.8-daemon-fix.1-mem.3 keeps owner.json {version, token, pid, processStartId,
    acquiredAt} inside the lock directory. mem.3 and older only rmdir a stale lock, which fails with ENOTEMPTY,
    so after that owner crashes a rolled-back binary never starts. The token names the lock's generation.
    The cleanup runs under a flock on <sock>.ctl-cleanup.flock, judges the directory through an open descriptor,
    and removes it only when the directory it renamed aside is that descriptor's directory with the same token.
    It never removes by age, never while a daemon process still runs on the socket, and never while the owner pid
    is alive with its recorded start id.
    """
    lock = f"{sock}.lock"
    with open(f"{sock}.ctl-cleanup.flock", "a") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        try:
            dirfd = os.open(lock, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        except FileNotFoundError:
            return False
        except OSError as error:
            print(f"left the socket lock {lock} in place: it cannot be opened as a directory ({error.strerror})", file=sys.stderr)
            return False
        try:
            return clear_judged_lock(sock, lock, dirfd)
        except OSError as error:
            print(f"left the socket lock {lock} as the cleanup found it: {error}", file=sys.stderr)
            return False
        finally:
            os.close(dirfd)


def clear_judged_lock(sock, lock, dirfd):
    def leave(reason):
        print(f"left the socket lock {lock} in place: {reason}", file=sys.stderr)
        return False

    owner = lock_owner(dirfd)
    if isinstance(owner, str):
        return leave(owner)
    entries = os.listdir(dirfd)
    extra = [e for e in entries if e != OWNER_FILE and not e.startswith(f".{OWNER_FILE}.")]
    if extra:
        return leave(f"it holds entries Prime does not write there: {' '.join(sorted(extra))}")
    holders = socket_daemons(sock, set())
    if holders:
        return leave(f"prime-agent daemon {' '.join(map(str, holders))} still runs on {sock}")
    gone, kept = owner_gone(owner)
    if kept:
        return leave(kept)
    judged = os.fstat(dirfd)
    try:
        now = os.stat(lock, follow_symlinks=False)
    except FileNotFoundError:
        return False
    if (now.st_dev, now.st_ino) != (judged.st_dev, judged.st_ino):
        return leave("another generation replaced it while it was judged")
    aside = f"{lock}.ctl-reaped-{os.getpid()}-{owner['token']}"
    try:
        rename_noreplace(lock, aside)
    except FileNotFoundError:
        return False
    moved = os.stat(aside, follow_symlinks=False)
    moved_owner = lock_owner(dirfd)
    if (moved.st_dev, moved.st_ino) != (judged.st_dev, judged.st_ino) or not isinstance(moved_owner, dict) or moved_owner["token"] != owner["token"]:
        try:
            rename_noreplace(aside, lock)
        except OSError as error:
            return leave(f"another generation replaced it during the rename and it could not go back ({error.strerror}); it stays at {aside}")
        return leave("another generation replaced it during the rename, so it was put back")
    for entry in os.listdir(dirfd):
        os.unlink(entry, dir_fd=dirfd)
    os.rmdir(aside)
    print(f"removed the stale socket lock {lock} of generation {owner['token']}: {gone}", file=sys.stderr)
    return True


def start(prime_agent, sock, pidfile):
    child = None
    reported = False
    holder_since = None
    holder_reported = False
    cleared = False
    while True:
        pid = supervisor_pid(sock)
        if pid:
            if child and child.poll() is None and child.pid != pid:
                child.terminate()
                print(f"supervisor {pid} took the socket first; stopped the one this unit started ({child.pid})", file=sys.stderr)
            write_pidfile(pidfile, pid)
            if cgroup(pid) != cgroup(os.getpid()):
                print(f"supervisor {pid} runs outside this unit ({cgroup(pid)}) and stops with that cgroup; run updates with systemctl --user reload", file=sys.stderr)
            print(f"supervisor {pid} owns {sock}")
            return OK
        coordinator = update_restart_coordinator(sock)
        if coordinator and not reported and coordinator_age(coordinator) > coordinator_budget(coordinator):
            reported = True
            print(f"update restart coordinator {coordinator.get('pid')} has run {int(coordinator_age(coordinator))} s, past the {coordinator_budget(coordinator)} s sum of Prime's step deadlines; still waiting for it", file=sys.stderr)
        if child is None:
            if not coordinator:
                clear_dead_lock(sock)
                child = subprocess.Popen([prime_agent, "--mode", "daemon", "--daemon-socket", sock], stdin=subprocess.DEVNULL, start_new_session=True, env=target_env(sock))
        elif child.poll() is not None and not coordinator:
            holders = socket_daemons(sock, {child.pid})
            if holders and holder_since is None:
                holder_since = time.time()
                print(f"prime-agent daemon {child.pid} exited with {child.returncode} before it answered on {sock}, and supervisor {' '.join(map(str, holders))} still starts on it and holds its lock (ELOCKED); waiting for its hello", file=sys.stderr)
            elif holders and not holder_reported and time.time() - holder_since > SUCCESSOR_START_SECONDS:
                holder_reported = True
                print(f"supervisor {' '.join(map(str, holders))} has held the {sock} lock for {int(time.time() - holder_since)} s without a hello, past the {SUCCESSOR_START_SECONDS} s Prime allows a successor from launch to hello; still waiting for it", file=sys.stderr)
            elif not holders and holder_since is not None:
                print(f"the supervisor that held the {sock} lock exited without a hello; starting a new one", file=sys.stderr)
                child, holder_since, holder_reported = None, None, False
                continue
            elif not holders and not cleared and clear_dead_lock(sock):
                cleared = True
                child = None
                continue
            elif not holders:
                print(f"prime-agent daemon {child.pid} exited with {child.returncode} before it answered on {sock}", file=sys.stderr)
                return child.returncode or FAILED
        time.sleep(POLL_SECONDS)


def classify(code, output):
    """Name the outcome of the install and restart from the last exit code and their joined output.

    The install exits 1 when the busy-session confirmation refuses without a TTY and 75 when it installed nothing.
    The coordinator exits 1 when it fails, and restart_report then names the failure in Prime's words, including a
    prepare refusal, where the running daemon declined the restart.
    """
    if code == NOT_ATTEMPTED:
        return FAILED, "prime-agent update installed nothing: no newer release, a refused downgrade or an unreachable feed"
    if "Could not prepare daemon sessions for automatic resume" in output:
        return PREPARE_REFUSED, "prepare refused: the running daemon declined the restart and still runs the previous version; --force does not override this, fix the cause Prime names first"
    if code != 0 and "Re-run with --force to proceed." in output and ("busy session" in output or "Running agents could not be listed" in output):
        return BUSY_REFUSED, "busy-session confirmation refused: busy sessions need PRIME_UPDATE_ARGS=--force, which checkpoints and restores them; nothing was installed"
    if "could not restart the daemon (" in output or "could not coordinate the daemon restart" in output:
        return RESTART_FAILED, "restart failed: the update installed but the daemon restart did not complete"
    if code != 0:
        return FAILED, f"prime-agent update exited with {code}"
    return OK, "updated"


def run(argv, env):
    """Run one prime-agent command, copy its output to the journal, and return its exit code and output."""
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env, text=True, errors="replace")
    lines = []
    for line in proc.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
        lines.append(line)
    return proc.wait(), "".join(lines)


def restart_report(status):
    """The warning `prime-agent update` prints for a failed coordinator, in Prime's wording, so classify reads it as before.

    The coordinator prints its own restore counts.
    """
    if not isinstance(status, dict) or status.get("phase") not in ("complete", "skipped", "failed"):
        return "Warning: Updated, but could not restart the daemon (the coordinator left no final status).\n"
    if status["phase"] == "failed":
        return f"Warning: Updated, but could not restart the daemon ({status.get('message') or 'unknown error'}).\n"
    return ""


def restart(prime_agent, sock):
    agent_dir = Path(os.environ.get("PRIME_AGENT_CODING_AGENT_DIR") or "~/.prime/agent").expanduser()
    restarts = agent_dir / "update-restarts"
    restarts.mkdir(mode=0o700, parents=True, exist_ok=True)
    status_path = restarts / f"ctl-{os.getpid()}-{int(time.time())}.json"
    env = target_env(sock, PRIME_AGENT_CODING_AGENT_DIR=str(agent_dir))
    code, output = run([prime_agent, "update", COORDINATOR_FLAG, "--daemon-socket", sock, STATUS_FLAG, str(status_path)], env)
    try:
        status = json.loads(status_path.read_text())
    except (OSError, ValueError):
        status = None
    report = restart_report(status)
    sys.stdout.write(report)
    sys.stdout.flush()
    return code, output + report, status


def restored(status):
    """`restored N of M` from the coordinator's update-restarts record."""
    counts = status.get("counts") if isinstance(status, dict) else None
    if not isinstance(counts, dict) or not isinstance(counts.get("restored"), int) or not isinstance(counts.get("total"), int):
        return "restored unknown of unknown"
    return f"restored {counts['restored']} of {counts['total']}"


def update(prime_agent, sock, pidfile, env_file=None):
    if env_file:
        try:
            os.truncate(env_file, 0)
        except FileNotFoundError:
            pass
    try:
        args = shlex.split(os.environ.get("PRIME_UPDATE_ARGS", ""))
    except ValueError as error:
        args = [f"<{error}>"]
    unknown = [a for a in args if a not in UPDATE_ARGS]
    if unknown:
        print(f"prime-agent-daemon-ctl: result=usage PRIME_UPDATE_ARGS takes only {' '.join(UPDATE_ARGS)}, got {' '.join(unknown)}", file=sys.stderr)
        return USAGE
    feed = {k: os.environ[k] for k in FEED if k in os.environ}
    status = None
    code, output = run([prime_agent, "update", "--self", *args], target_env(sock, PRIME_AGENT_INTERNAL_DAEMON_SUPERVISOR_SOCKET=sock, **feed, **{INSTALL_ONLY: "1"}))
    if code == 0:
        code, restart_output, status = restart(prime_agent, sock)
        output += restart_output
    code, message = classify(code, output)
    names = {OK: "ok", FAILED: "failed", BUSY_REFUSED: "busy-refused", PREPARE_REFUSED: "prepare-refused", RESTART_FAILED: "restart-failed"}
    if code != RESTART_FAILED:
        print(f"prime-agent-daemon-ctl: result={names[code]} {message}", file=sys.stderr if code else sys.stdout, flush=True)
        started = start(prime_agent, sock, pidfile)
        return code or started
    started = start(prime_agent, sock, pidfile)
    if started != OK:
        print(f"prime-agent-daemon-ctl: result=restart-failed {message}; {restored(status)}", file=sys.stderr, flush=True)
        return RESTART_FAILED
    pid = Path(pidfile).read_text().strip()
    print(f"prime-agent-daemon-ctl: result=restore-failed-successor-adopted {restored(status)}; the coordinator failed, supervisor {pid} owns {sock}; exit 0 so systemd keeps the unit active and reads the PIDFile, and Prime's own recovery restores the sessions", file=sys.stderr, flush=True)
    return OK


def main(argv):
    if not (len(argv) == 4 and argv[0] == "start" or len(argv) in (4, 5) and argv[0] == "update"):
        print(__doc__.strip().splitlines()[-1], file=sys.stderr)
        return USAGE
    command, prime_agent, sock, pidfile, *env_file = argv
    if Path(sock).parent.name != f"prime-agent-{os.getuid()}":
        print(f"{sock} is not in a prime-agent-{os.getuid()} directory, so TMPDIR cannot point Prime's default socket and coordinator registry at it", file=sys.stderr)
        return USAGE
    if command == "start":
        return start(prime_agent, sock, pidfile)
    return update(prime_agent, sock, pidfile, *env_file)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
