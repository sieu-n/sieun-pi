[Unit]
Description=sieun-pi browser chat on 127.0.0.1:5182
Wants=prime-agent-daemon.service
# No After= on prime-agent-daemon.service: systemd holds a start job of a unit ordered after another until that unit's
# running job ends, and a daemon update's ExecReload runs for minutes. On 10-20 a chat release restarted this unit at
# 03:09:55Z during the 03:07:15Z daemon update, the start waited for its 03:14:09Z end, and no alert reached a chat for
# 253 s (mac-alert-bridge-stale fired). The chat retries a daemon that does not answer yet, as on the Mac.
After=sieun-pi-chat.socket
Requires=sieun-pi-chat.socket

[Service]
Type=simple
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SIEUN_PI_CHAT_START_DAEMON=0
Environment=SIEUN_PI_CHAT_OPEN_AT_LOGIN=0
# libuv's default of 4 pool threads is what every file read of the chat waits on. On 10-27 one recursive readdir held all 4 for 3.1 s while a
# stat behind it waited as long, and with 5 to 64 threads the same stat passed in 1 ms. 16 holds four such 4-thread walks on this 80-core box.
Environment=UV_THREADPOOL_SIZE=16
EnvironmentFile=-%h/.config/sieun-pi/agent.env
EnvironmentFile=-%h/.config/sieun-pi/chat.env
ExecStart=%h/.local/node/bin/node %h/.local/share/sieun-pi-chat/current/components/user-history/src/chat-service-cli.mjs serve --data-dir %h/.prime/agent/browser-chat --port 5182 --socket /tmp/prime-agent-%U/daemon.sock
KillMode=mixed
# A kernel OOM kill of one precheck or helper the chat started ends only that process, as in prime-agent-daemon.service.
OOMPolicy=continue
Restart=always
RestartSec=10
UMask=0077
StandardOutput=append:%h/.prime/agent/browser-chat/service.log
StandardError=append:%h/.prime/agent/browser-chat/service.log

[Install]
WantedBy=default.target
