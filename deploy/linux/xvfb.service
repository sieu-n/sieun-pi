[Unit]
Description=Virtual X display :99 for cua-driver computer use

[Service]
WorkingDirectory=%h/.local/opt/xvfb/usr/bin
Environment=LD_LIBRARY_PATH=%h/.local/opt/xvfb/usr/lib/x86_64-linux-gnu
ExecStart=%h/.local/opt/xvfb/usr/bin/Xvfb-localxkb :99 -screen 0 1920x1080x24 -nolisten tcp -xkbdir /usr/share/X11/xkb
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
