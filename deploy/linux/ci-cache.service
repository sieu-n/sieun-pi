[Unit]
Description=ci-cache: the one GitHub Actions poller for sieu-n/auto-sns-agent (scripts/dev/ci-cache.mjs poll, run from the box's sieun/dev tip through run-from-head.mjs --tip --follow-head, restarted only when a file it loads changes), writing ~/.cache/virev/ci-runs.json for ci-run-status, the gh shim and board.wake(run=)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CI_CACHE_REAL_GH=%h/.local/opt/gh-2.89.0/bin/gh
Environment=CI_CACHE_QUOTA_PROM=%h/box-ops/obs/textfile/devbox-github-quota.prom
WorkingDirectory=%h/.cache/virev/tip-export
ExecStart=%h/.local/node/bin/node %h/.cache/virev/tip-export/current/scripts/dev/run-from-head.mjs --tip --follow-head %h/Documents/Github/auto-sns-agent scripts/dev/ci-cache.mjs poll
Restart=always
RestartSec=30
StandardOutput=append:%h/.cache/virev/ci-cache.log
StandardError=append:%h/.cache/virev/ci-cache.log

[Install]
WantedBy=default.target
