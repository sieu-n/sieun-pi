[Unit]
Description=Prime Agent daemon for the sieun-pi chat
After=network-online.target

[Service]
Type=forking
PIDFile=%t/prime-agent-daemon.pid
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NO_COLOR=1
EnvironmentFile=-%h/.config/sieun-pi/agent.env
EnvironmentFile=-%h/.config/sieun-pi/prime-update.env
ExecStartPre=/bin/mkdir -p -m 0700 /tmp/prime-agent-%U
ExecStart=%h/.local/bin/prime-agent-daemon-ctl start %h/.local/bin/prime-agent /tmp/prime-agent-%U/daemon.sock %t/prime-agent-daemon.pid
ExecReload=%h/.local/bin/prime-agent-daemon-ctl update %h/.local/bin/prime-agent /tmp/prime-agent-%U/daemon.sock %t/prime-agent-daemon.pid %h/.config/sieun-pi/prime-update.env
Restart=always
RestartSec=5
UMask=0077
# systemd times ExecReload with TimeoutStartSec, and a reload waits on Prime's update restart coordinator, whose step
# deadlines add up to 355 s plus 360 s per restored session with no total cap. On a timeout systemd kills the ctl,
# which drops the update's result and skips the PIDFile read, so prime-agent-daemon-ctl reports a run past that sum.
TimeoutStartSec=infinity
TimeoutStopSec=90
KillMode=process

[Install]
WantedBy=default.target
