[Unit]
Description=secrets-watch: the 15-minute check that no secret left the agents (GitHub run logs, new commits, PR and issue text, public pages), with tickets to the ops-gateway on us-metal01 (box copy of the Mac's launchd ai.virev.secrets-watch)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=VIREV_CHECKOUT=%h/Documents/Github/auto-sns-agent
WorkingDirectory=%h/Documents/Github/auto-sns-agent/apps/llm-wiki/content/sessions/2026/10/14/1121-secrets-self-heal/a/run
ExecStart=%h/.local/node/bin/node %h/Documents/Github/auto-sns-agent/apps/llm-wiki/content/sessions/2026/10/14/1121-secrets-self-heal/a/run/scripts/dev/secrets-watch.mjs --log-dir %h/Documents/Github/auto-sns-agent/apps/llm-wiki/content/sessions/2026/10/14/1121-secrets-self-heal/a/data/watch
TimeoutStartSec=14min
StandardOutput=null
StandardError=append:%h/Documents/Github/auto-sns-agent/apps/llm-wiki/content/sessions/2026/10/14/1121-secrets-self-heal/a/data/watch/launchd.err.log
