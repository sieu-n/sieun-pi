[Unit]
Description=wiki-box-commit: commit the wiki pages written on this wiki host onto its dev/sieun
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/Documents/Github/auto-sns-agent
ExecStart=%h/.local/node/bin/node scripts/repo/agent/wiki-box-commit.mjs
