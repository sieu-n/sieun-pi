# The port of apps/chat (deploy/linux/sieun-pi-apps-chat.service), held by systemd across the server's restarts and hand-overs, so a call
# waits in the socket's queue instead of being refused. tailscale serve keeps pointing at http://127.0.0.1:5184.
[Unit]
Description=apps/chat port 127.0.0.1:5184, held across apps/chat restarts

[Socket]
ListenStream=127.0.0.1:5184

[Install]
WantedBy=sockets.target
