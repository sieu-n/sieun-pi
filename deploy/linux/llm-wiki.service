[Unit]
Description=llm-wiki, the one wiki server for every box, on 127.0.0.1:5176 behind Tailscale Serve
After=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/Documents/Github/auto-sns-agent/apps/llm-wiki
ExecStart=%h/.local/node/bin/pnpm run dev
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
