[Unit]
Description=Run ci-head-fetch every 5 minutes, so the box's origin/sieun/dev follows the pushed head

[Timer]
OnBootSec=1min
# 5 min, from measurements on 10-18: one fetch takes 0.45 s and spends no REST quota (/usr/bin/time, 06:2xZ).
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
