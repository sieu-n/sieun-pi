# Meilisearch, the search index of apps/chat (server/search-engine.ts) on 127.0.0.1:7700. scripts/install-meilisearch.mjs installs the
# pinned binary under ~/.local/opt/meilisearch, writes the master key to ~/.config/meilisearch (master.key for the chat, env for this unit)
# and this unit. Its data lives in ~/.local/share/meilisearch.
[Unit]
Description=Meilisearch for apps/chat search (127.0.0.1:7700)

[Service]
Type=simple
WorkingDirectory=%h/.local/share/meilisearch
EnvironmentFile=%h/.config/meilisearch/env
ExecStart=%h/.local/opt/meilisearch/current/meilisearch --http-addr 127.0.0.1:7700 --db-path %h/.local/share/meilisearch/data.ms --dump-dir %h/.local/share/meilisearch/dumps --env production --no-analytics
# Raised, not capped: on 11-03 indexing pi-host's 65,797 entries failed with "Too many open files (os error 24)" at the default 1,024.
LimitNOFILE=524288
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
