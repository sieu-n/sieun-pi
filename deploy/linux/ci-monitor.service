[Unit]
Description=ci-monitor: the CI access monitor (scripts/dev/ci-monitor.mjs run from the box's sieun/dev tip through run-from-head.mjs --tip), writing snapshot.md, history.jsonl, state.json and dashboard/ for the wiki's /playground/ci (box copy of the Mac's launchd ai.virev.ci-monitor)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ~/.local/bin comes first for gh (the ci-cache shim, which passes `gh auth token` to the real gh) and rg.
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/.cache/virev/tip-export
ExecStart=%h/.local/node/bin/node %h/.cache/virev/tip-export/current/scripts/dev/run-from-head.mjs --tip %h/Documents/Github/auto-sns-agent scripts/dev/ci-monitor.mjs run --output-dir %h/Documents/Github/auto-sns-agent/apps/llm-wiki/content/sessions/2026/10/08/0624-ci-access-monitor/logs --interval-seconds 600
TimeoutStartSec=15min
StandardOutput=null
StandardError=append:%h/Documents/Github/auto-sns-agent/apps/llm-wiki/content/sessions/2026/10/08/0624-ci-access-monitor/logs/launchd.log
