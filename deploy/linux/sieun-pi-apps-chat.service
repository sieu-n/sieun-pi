# apps/chat, the new chat app on pi-host, beside the live chat (:5182) and the canary (:5183), never replacing either.
# It runs the installed release under ~/.local/share/sieun-pi-apps-chat/current, which scripts/release-apps-chat.mjs builds from a commit on origin main.
# Its own state (channels, read marks, duties) lives in ~/.pi/agent/chat; every thread lives in pi-host's durable files.
# Tailnet: tailscale serve --bg --https=5184 http://127.0.0.1:5184
# sieun-pi-apps-chat.socket holds the port, so a call that comes while no process accepts waits instead of being refused. A release reloads
# this unit: the running server starts its successor on the socket and hands over to it (server/handoff.ts), and the port never closes.
# The unit before the hand-over is deploy/linux/rollback/sieun-pi-apps-chat.service; its comment has the one command that puts it back.
[Unit]
Description=apps/chat, the sieun-pi chat app on pi-host (127.0.0.1:5184)
After=pi-host.service sieun-pi-apps-chat.socket
Wants=pi-host.service
Requires=sieun-pi-apps-chat.socket

[Service]
# The server tells systemd READY=1 once it listens, and a successor tells it MAINPID= when it takes the port, before the old server exits.
Type=notify
NotifyAccess=all
ExecReload=/bin/kill -HUP $MAINPID
# The successor starts in the release this link names at the reload; the running server's own cwd is the release it started from.
Environment=APPS_CHAT_CURRENT=%h/.local/share/sieun-pi-apps-chat/current/apps/chat
WorkingDirectory=%h/.local/share/sieun-pi-apps-chat/current/apps/chat
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=AGENT_CHAT_SHARED_DIR=%h/.prime/agent/browser-chat
# The d2 orphan reaper (legacy/prime/user-history/src/orphan-reaper.ts) keeps a transient unit whose PRIME_OWNER_UNIT has a unit file. The duty
# prechecks run as transient duty-*-run units (server/duty-run.ts) with this env, and on 11-22 two of them read as orphan_unknown, 5 processes.
Environment=PRIME_OWNER_UNIT=sieun-pi-apps-chat.service
# Search's index (server/search-engine.ts) lives in the Komodo container box-sieun-pi-meilisearch-1 (scripts/install-meilisearch.mjs).
Environment=APPS_CHAT_MEILI_URL=http://127.0.0.1:7700
Environment=APPS_CHAT_MEILI_KEY_FILE=%h/.config/meilisearch/master.key
ExecStart=%h/.local/node/bin/node --import tsx server/main.ts --port 5184 --listen 127.0.0.1 --data-dir %h/.pi/agent/chat --socket %t/pi-host/host.sock
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
