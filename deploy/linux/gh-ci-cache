#!/bin/bash
# ci-cache gh shim (box copy of the Mac's ai.virev.ci-cache wrapper): answers gh run view|list|watch and gh api .../actions/runs/<id>
# from /home/sieun/.cache/virev/ci-runs.json, which ci-cache.service writes. Anything else runs the real gh.
# It runs the shim code from the tip export (the box's dev/sieun), as ci-cache.service does.
# ~/.local/opt/gh links the gh version box-parity follows from the Mac (box-follow.sh).
export CI_CACHE_REAL_GH=/home/sieun/.local/opt/gh/bin/gh
HEAD_EXPORT=/home/sieun/.cache/virev/tip-export/current/scripts/dev
case "$1" in
run|api)
	if [ "$1" = run ] && [ "$2" = watch ]; then
		NODE="/home/sieun/.local/node/bin/node" /bin/sh "$HEAD_EXPORT/gh-run-watch.sh" "${@:3}"; rc=$?
	else
		"/home/sieun/.local/node/bin/node" "$HEAD_EXPORT/gh-cache-shim.mjs" "$@"; rc=$?
	fi
	[ $rc -ne 120 ] && exit $rc;;
esac
exec "$CI_CACHE_REAL_GH" "$@"
