[Unit]
Description=Moves the agents' control loop into agents.slice and the commands the Prime workers start into prime-agent-tools.scope (CPU layer 2 of deploy/linux/README.md, owner's t84 answer 10-19)
After=user@1001.service

[Service]
ExecStart=/usr/bin/python3 -B /usr/local/lib/cpu-protect/cpu-protect.py
Restart=always

[Install]
