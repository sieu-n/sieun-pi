{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "verbatimModuleSyntax": false
  },
  "include": [
    "./**/*.ts",
    "../test/server/**/*.ts",
    "../web/src/lib/api/**/*.ts"
  ],
  "exclude": [
    "../web/src/lib/api/**/*.svelte.ts",
    "../web/src/lib/api/index.ts"
  ]
}
