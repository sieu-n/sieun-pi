# The copy unit of the hand-over rig (run.sh fills in @CODE@, @DATA@, @OUT@ and @PORT@). It is the live unit with the fixture host and its own port.
[Unit]
Description=apps/chat hand-over copy rig on 127.0.0.1:@PORT@ (fixture, throwaway)
After=apps-chat-handoff-copy.socket
Requires=apps-chat-handoff-copy.socket
[Service]
Type=notify
NotifyAccess=all
ExecReload=/bin/kill -HUP $MAINPID
Environment=APPS_CHAT_CURRENT=@CODE@
Environment=APPS_CHAT_UNIT=%n
WorkingDirectory=@CODE@
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=@OUT@/home
Environment=TMPDIR=@OUT@/tmp
# rig-test.mjs runs a wiki engine stand-in here that answers each call after 3 s.
# Each agent create waits 10 s in the fixture host, as a slow pi-host create does, so the rig can put a write in flight across a hand-over.
Environment=APPS_CHAT_FIXTURE_CREATE_MS=10000
Environment=APPS_CHAT_WIKI_ENGINE=http://127.0.0.1:@WIKIPORT@
ExecStart=%h/.local/node/bin/node --import tsx server/main.ts --fixture --port @PORT@ --listen 127.0.0.1 --data-dir @DATA@
# systemd kills a server that stops pinging (server/handoff.ts startWatchdog) and Restart= starts it again. The longest event-loop stall in the
# request logs of 11-20 to 11-22 was 5.0 s, so 15 s is three times that. SIGKILL also ends a stopped process, which ignores SIGABRT.
WatchdogSec=15
WatchdogSignal=SIGKILL
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=always
RestartSec=2
