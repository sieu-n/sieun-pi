{
  "name": "sieun-pi-apps-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The chat server of apps/chat: threads, jobs, channels, search, boards, usage and hosts over pi-host.",
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "start": "node --import tsx server/main.ts",
    "fixture": "node --import tsx server/main.ts --fixture --port 5186",
    "test": "node --import tsx --test --test-force-exit --test-timeout=120000 test/server/*.test.ts",
    "typecheck": "tsc --noEmit -p server/tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "marked": "18.1.3",
    "tsx": "4.23.13",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "25.3.0",
    "@types/turndown": "5.0.6",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
