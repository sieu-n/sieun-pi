+# dill.FILE_FMODE: a handle saved in this mode rewrites its target with the saved contents on load.
+_DILL_FILE_FMODE = 2
+# Names dill maps to sys streams or fresh temp files on load, never to a user path.
+_DILL_STREAM_NAMES = {"<stdin>", "<stdout>", "<stderr>", "<tmpfile>", "<fdopen>"}
+
+
+def _reopen_is_unsafe(name: Any, mode: Any, fmode: Any) -> bool:
+    """True when dill's _create_filehandle would write the saved target on load: w/a/x/+
+    modes open it for writing ('w' truncates), FILE_FMODE rewrites it, and an int name
+    reopens whatever file now owns that descriptor number (prime-agent#3447)."""
+    if isinstance(name, int):
+        return True
+    if name in _DILL_STREAM_NAMES:
+        return False
+    return fmode == _DILL_FILE_FMODE or not isinstance(mode, str) or any(flag in mode for flag in "wax+")
+
+
+def _is_file_handle(value: Any) -> bool:
+    return isinstance(value, io.IOBase) and isinstance(getattr(value, "mode", None), str)
+
+
+class _UnsafeFileHandle(Exception):
+    pass
+
+
+def _refuse_unsafe_handle_dumps(dill: Any) -> Callable[[], None]:
+    """Make dill raise _UnsafeFileHandle on a file handle a later load would reopen for writing; returns the undo.
+    It swaps dill's module-level saver, so dill.dump itself stays the call site."""
+    module = dill._dill
+    save_file = module._save_file
+
+    def save_guarded(pickler: Any, obj: Any, open_: Any) -> Any:
+        name, mode = getattr(obj, "name", None), getattr(obj, "mode", None)
+        if _reopen_is_unsafe(name, mode, getattr(pickler, "_fmode", 0)):
+            raise _UnsafeFileHandle(f"{name!r} mode {mode!r}")
+        return save_file(pickler, obj, open_)
 
+    module._save_file = save_guarded
 
+    def undo() -> None:
+        module._save_file = save_file
+
+    return undo
+
+
+def _defuse_unsafe_handle_loads(dill: Any, defused: list[str]) -> Callable[[], None]:
+    """Make dill revive a saved write-mode file handle as a closed os.devnull handle and append its saved
+    target to defused, instead of reopening (and for 'w', truncating) it; returns the undo."""
+    module = dill._dill
+    create = module._create_filehandle
+
+    def create_guarded(name, mode, position, closed, open_, strictio, fmode, fdata):  # type: ignore[no-untyped-def]
+        if _reopen_is_unsafe(name, mode, fmode):
+            defused.append(f"{name!r} mode {mode!r}" + (" fmode FILE_FMODE" if fmode == _DILL_FILE_FMODE else ""))
+            return create(os.devnull, "r", 0, True, open, False, 0, "")
+        return create(name, mode, position, closed, open_, strictio, fmode, fdata)
+
+    module._create_filehandle = create_guarded
+
+    def undo() -> None:
+        module._create_filehandle = create
+
+    return undo
+
