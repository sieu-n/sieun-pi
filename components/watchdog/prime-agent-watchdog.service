[Unit]
Description=Prime Agent frozen-session watchdog, one cycle
After=prime-agent-daemon.service

[Service]
Type=oneshot
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NO_COLOR=1
Environment=PRIME_AGENT_DAEMON_SOCK=/tmp/prime-agent-%U/daemon.sock
ExecStart=/usr/bin/python3 -B %h/.local/share/prime-watchdog/current/cron_cycle.py
StandardOutput=append:%h/.prime/agent/watchdog/cron.out.log
StandardError=append:%h/.prime/agent/watchdog/cron.err.log
TimeoutStartSec=15min
