{
  "name": "prime-agent-user-history",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Read saved history and chat with native Prime Agent sessions through a standalone local server.",
  "engines": {
    "node": ">=22.8.0"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
