  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@earendil-works/pi-ai": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.9.8/prime-agent-ai-0.9.8.tgz",
    "@silvia-odwyer/photon-node": "0.3.4",
    "esbuild": "0.28.2",
    "esbuild-svelte": "0.9.5",
    "marked": "18.0.12",
    "mermaid": "12.0.0",
    "prime-agent": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.9.8/prime-agent-0.9.8.tgz",
    "svelte": "5.57.1",
    "tsx": "4.23.13",
    "uqr": "0.1.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "25.3.0",
    "@types/ws": "8.18.2",
    "parse5": "8.0.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3"
  },
