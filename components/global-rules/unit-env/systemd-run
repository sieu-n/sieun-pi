#!/bin/sh
# A systemd-run unit starts from the user manager's environment, so a Python it runs would not load the global-rules guards that a kernel's
# own children load through PYTHONPATH (python-child/sitecustomize.py). On 10-20 at 21:19Z a subagent of 'd5 cache reads' ran a scan script
# with systemd-run --user ... -E PATH sh -c 'python3 scan.py', and that Python read other chats' transcripts with no guard. kernel-read.py puts
# this folder first on PATH, and this file runs the next systemd-run on PATH with the guards' variables passed through -E.
here=$(cd "$(dirname "$0")" && pwd -P)
real=""
rest=$PATH
while [ -n "$rest" ]; do
  dir=${rest%%:*}
  case $rest in *:*) rest=${rest#*:} ;; *) rest="" ;; esac
  [ -n "$dir" ] && [ -x "$dir/systemd-run" ] && [ "$(cd "$dir" 2>/dev/null && pwd -P)" != "$here" ] && { real=$dir/systemd-run; break; }
done
[ -n "$real" ] || { echo "systemd-run: command not found" >&2; exit 127; }
# A unit starts from the user manager's PATH, where unit-env/prime-agent is not, so prime-shutdown.py refuses a `prime-agent shutdown` in its
# command or scripts unless the unit gets the kernel's PATH with -E PATH. On 10-27 at 17:07:46Z the unit svh-teardown-r01 ran
# `<release>/prime-agent shutdown --force --json`, and it stopped the live daemon and every agent on us-metal02 (~/work/d7-supervisor-exits/TRACE.md).
python3 -I -S "$here/../prime-shutdown.py" --unit "$@" || exit 2
# A unit that runs prime-agent on a socket other than the public one is a scratch daemon or its client. Passing it this kernel's Prime dir
# made it write into the live agent dir: on 10-22 at 02:16:45Z a scratch daemon started this way wrote a session, a lease, a worker folder and
# two logs under ~/.prime/agent. Such a unit gets no Prime or chat dir from here and must name its own PRIME_AGENT_CODING_AGENT_DIR outside it.
public=/tmp/prime-agent-$(id -u)/daemon.sock
live=$(realpath -m "$HOME/.prime/agent")
scratch="" agent=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "--daemon-socket" ]; then sock=$arg; else
    sock=$(printf '%s\n' "$arg" | sed -n "s/.*--daemon-socket[=' \"]*\([^' \"]*\).*/\1/p" | head -n 1)
  fi
  [ -n "$sock" ] && [ "$(realpath -m "$sock")" != "$public" ] && scratch=$sock
  given=$(printf '%s\n' "$arg" | sed -n "s/.*PRIME_AGENT_CODING_AGENT_DIR=[' \"]*\([^' \"]*\).*/\1/p" | head -n 1)
  [ -n "$given" ] && agent=$given
  prev=$arg
done
if [ -n "$scratch" ]; then
  case "$(realpath -m "${agent:-$live}")" in
    "$live"|"$live"/*)
      echo "systemd-run: refused: prime-agent on socket $scratch needs its own PRIME_AGENT_CODING_AGENT_DIR outside $live (given: ${agent:-none})" >&2
      exit 2 ;;
  esac
fi
if [ -n "${RLM_SESSION_DIR:-}" ]; then
  [ -n "$scratch" ] && dirs="" || dirs="PRIME_AGENT_CODING_AGENT_DIR PI_CODING_AGENT_DIR AGENT_CHAT_DATA_DIR"
  for name in RLM_SESSION_DIR PYTHONPATH $dirs OWNER_OK \
      $(env | sed -n 's/^\(GLOBAL_RULES_[A-Za-z0-9_]*\)=.*/\1/p'); do
    eval "given=\${$name+x}"
    [ "$given" = x ] && set -- -E "$name" "$@"
  done
fi
exec "$real" "$@"
