#!/bin/sh
# Runs `prime-agent shutdown` from a kernel's process only when it would not stop the live daemon (kernel-read.py puts this folder first on
# PATH). On 10-27 at 16:55:07Z a kernel bash ran `HOME=<scratch> TMPDIR=<scratch> prime-agent shutdown --force`. It still carried the kernel's
# PRIME_AGENT_CODING_AGENT_DIR, so Prime read the live workers' descriptors in ~/.prime/agent/daemon-workers and stopped the live supervisor
# and every agent on us-metal02 (~/work/d7-supervisor-exits/TRACE.md). Prime's shutdown stops every daemon its environment leads it to and
# takes no --daemon-socket, so this runs `prime-agent status --json` in the same environment first and refuses when that lists the live
# socket or fails. prime-shutdown.py refuses the shutdowns that would skip this file: a prime-agent named by path, a changed PATH, a unit
# without -E PATH. `prime-agent stop <agent>` stays open, since AGENTS.md names it as the way to restart one stuck agent.
here=$(cd "$(dirname "$0")" && pwd -P)
real=""
rest=$PATH
while [ -n "$rest" ]; do
  dir=${rest%%:*}
  case $rest in *:*) rest=${rest#*:} ;; *) rest="" ;; esac
  [ -n "$dir" ] && [ -x "$dir/prime-agent" ] && [ "$(cd "$dir" 2>/dev/null && pwd -P)" != "$here" ] && { real=$dir/prime-agent; break; }
done
[ -n "$real" ] || { echo "prime-agent: command not found" >&2; exit 127; }
command="" skip=""
for arg in "$@"; do
  if [ -n "$skip" ]; then skip=""; continue; fi
  case $arg in
    --mode|--cwd|--daemon-socket|--provider|--model|--api-key|--models|--thinking|-r|--resume|--fork|--session-dir|--goal|--goal-token-budget|-t|--tools|-e|--extension|--skill|--prompt-template|--theme|--system-prompt|--append-system-prompt|--autonomous-gate*|--autonomous-max-*|--autonomous-timeout-ms) skip=1 ;;
    -*) ;;
    *) command=$arg; break ;;
  esac
done
[ "$command" = shutdown ] || exec "$real" "$@"
# Prime's default socket: <tmpdir>/prime-agent-<uid>/daemon.sock, with /tmp on Linux and the login's temp folder on macOS, whatever TMPDIR says.
if [ -n "$GLOBAL_RULES_PRIME_LIVE_SOCKET" ]; then live=$GLOBAL_RULES_PRIME_LIVE_SOCKET
elif [ "$(uname)" = Darwin ]; then live=$(getconf DARWIN_USER_TEMP_DIR)prime-agent-$(id -u)/daemon.sock
else live=/tmp/prime-agent-$(id -u)/daemon.sock
fi
live=$(realpath -m "$live" 2>/dev/null || echo "$live")
found=$("$real" status --json 2>&1)
status=$?
targets=$(printf '%s\n' "$found" | sed -n 's/.*"socketPath": *"\([^"]*\)".*/\1/p')
hit=""
for sock in $targets; do
  [ "$(realpath -m "$sock" 2>/dev/null || echo "$sock")" = "$live" ] && hit=1
done
if [ "$status" -ne 0 ] || [ -n "$hit" ]; then
  [ "$status" -ne 0 ] && why="prime-agent status --json failed here, so the daemons it would stop are unknown" \
    || why="in this environment it would stop the live daemon on $live and every agent on this box (10-27 16:55Z and 17:07Z)"
  echo "prime-agent: refused: 'prime-agent shutdown' $why. Prime's shutdown stops every daemon that \`prime-agent status --json\` lists." \
    "To stop a scratch daemon, stop its unit (systemctl --user stop <unit>), or set HOME, TMPDIR and PRIME_AGENT_CODING_AGENT_DIR all to scratch." \
    "To restart one stuck agent, run prime-agent stop <agent>." >&2
  exit 2
fi
exec "$real" "$@"
