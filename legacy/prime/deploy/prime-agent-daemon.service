[Unit]
Description=Prime Agent daemon for the sieun-pi chat
After=network-online.target

[Service]
Type=forking
PIDFile=%t/prime-agent-daemon.pid
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NO_COLOR=1
# Prime load.3's service-placement hook: a worker that finds no supervisor on this socket runs the command instead of
# spawning one in its own process group (Prime docs/daemon.md). The supervisor passes both to its workers.
Environment="PRIME_AGENT_DAEMON_LAUNCH_COMMAND=systemctl --user start %n"
Environment=PRIME_AGENT_DAEMON_LAUNCH_FOR_SOCKET=/tmp/prime-agent-%U/daemon.sock
EnvironmentFile=-%h/.config/sieun-pi/agent.env
EnvironmentFile=-%h/.config/sieun-pi/prime-update.env
ExecStartPre=/bin/mkdir -p -m 0700 /tmp/prime-agent-%U
ExecStart=%h/.local/bin/prime-agent-daemon-ctl start %h/.local/bin/prime-agent /tmp/prime-agent-%U/daemon.sock %t/prime-agent-daemon.pid
ExecReload=%h/.local/bin/prime-agent-daemon-ctl update %h/.local/bin/prime-agent /tmp/prime-agent-%U/daemon.sock %t/prime-agent-daemon.pid %h/.config/sieun-pi/prime-update.env
# systemd reads the PIDFile only after a successful ExecReload. After a failed one it finds the old MainPID dead,
# counts the unit as stopped and Restart= starts it again, so prime-agent-daemon-ctl update exits 0 on restart-failed
# once a supervisor owns the socket (10-18 06:47Z: NRestarts 0 to 1 when the successor listened 2 s late).
Restart=always
RestartSec=5
UMask=0077
# systemd times ExecReload with TimeoutStartSec, and a reload waits on Prime's update restart coordinator, whose step
# deadlines add up to 355 s plus 360 s per restored session with no total cap. On a timeout systemd kills the ctl,
# which drops the update's result and skips the PIDFile read, so prime-agent-daemon-ctl reports a run past that sum.
TimeoutStartSec=infinity
TimeoutStopSec=90
KillMode=process
# A kernel OOM kill of one agent command or worker in this unit ends only that process. Under the default OOMPolicy=stop,
# systemd SIGKILLed the supervisor after the kernel took processes here at 16:13:50Z and 16:28:09Z on 10-19, and every
# session's turn was cut; Prime's own worker recovery handles a lost worker.
OOMPolicy=continue

[Install]
WantedBy=default.target
