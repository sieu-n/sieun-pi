<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sieun.pi-history</string>
  <key>ProgramArguments</key>
  <array>
    <string>@NODE@</string>
    <string>@MAIN@</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/pi-history.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/pi-history.log</string>
</dict>
</plist>
