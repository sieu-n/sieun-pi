{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "*/src/**/*.ts",
    "*/test/**/*.ts",
    "*/index.ts",
    "*/*/src/**/*.ts",
    "*/*/test/**/*.ts",
    "*/*/index.ts",
    "pi-family/*.ts",
    "pi-testkit/*.ts"
  ]
}
