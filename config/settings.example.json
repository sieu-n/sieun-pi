{
  "telemetry": {
    "enabled": false
  },
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "packages": [],
  "bundledSkills": {
    "websearch": false
  },
  "mcpServers": {
    "aside": {
      "type": "stdio",
      "command": "aside",
      "args": [
        "mcp"
      ],
      "startupTimeoutMs": 20000,
      "callTimeoutMs": 130000
    }
  },
  "retry": {
    "provider": {
      "waitForUsage": {
        "pauseUntilReset": false,
        "maxWaitMs": 18300000,
        "maxAttempts": 80
      }
    }
  }
}
