{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "components/global-rules/**/*.ts",
    "components/claude-rules/**/*.ts",
    "legacy/prime/pi-pool-extension/**/*.ts"
  ]
}
